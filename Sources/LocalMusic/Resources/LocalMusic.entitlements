<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Intentionally not sandboxed: the app must exec unsigned Homebrew binaries
	     (yt-dlp, ffmpeg) which cannot inherit a sandbox. See docs/superpowers/specs. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
